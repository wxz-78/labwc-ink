# Ink — estilo común para editores (vim, helix, VS Code, etc.).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_size = 4

[bin/*]
indent_size = 4

# check.sh exige dos espacios en las etiquetas case de este script.
[bin/ink-wine]
indent_size = 2

[*.fish]
indent_size = 4

[Makefile]
indent_style = tab
