#!/usr/bin/env bash
# ink-wine — lanzador de Wine con el entorno afinado (prefijo de ./6-wine.sh).
#   ink-wine programa.exe [args]     ejecuta (.exe, .msi, .bat/.cmd) desde su propia carpeta
#   ink-wine cfg                     winecfg
#   ink-wine tricks verbo…           winetricks sobre este prefijo
#   ink-wine builtin                 quita los overrides de DXVK/vkd3d del prefijo (vuelve al Direct3D de Wine; no borra archivos)
#   ink-wine kill                    cierra todo lo de Wine (wineserver -k)
#   ink-wine info                    versión, prefijo, ntsync, Vulkan y verbos instalados
# Variables:  INK_WINEPREFIX=ruta (por defecto el prefijo de Wine, ~/.wine) · INK_GAMEMODE=1 (con gamemoderun si está instalado)
#             DXVK_HUD=fps (se respeta) · INK_WINEDEBUG=err+all (por defecto fixme-all: los errores SÍ salen en la terminal)
#             INK_WINE_BUILTIN=1 (ignora DXVK/vkd3d del prefijo para esta ejecución: prueba si la ventana en negro es culpa de ellos)
#             INK_PULSE_LATENCY=60 (ms; 0 = no tocar)
PREFIX_DEFAULT="$HOME/.wine"
case "${1:-}" in ""|-h|--help) sed -n '2,/^[^#]/{/^[^#]/!p}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
command -v wine >/dev/null 2>&1 || { echo "wine no está instalado: ejecuta ./6-wine.sh" >&2; exit 1; }

unset WINEARCH   # un WINEARCH=win32 heredado rompe el nuevo WoW64
export WINEPREFIX="${INK_WINEPREFIX:-${WINEPREFIX:-$PREFIX_DEFAULT}}"
export WINEDEBUG="${INK_WINEDEBUG:-${WINEDEBUG:-fixme-all}}"   # sin «fixme», pero con errores: si algo falla, la terminal lo dice
export WINEDLLOVERRIDES="winemenubuilder.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"   # sin accesos ni asociaciones de Wine
# Direct3D integrado de Wine en vez de DXVK/vkd3d (solo para esta ejecución; no toca el prefijo)
[ "${INK_WINE_BUILTIN:-0}" = 1 ] && WINEDLLOVERRIDES="$WINEDLLOVERRIDES;d3d8,d3d9,d3d10core,d3d11,d3d12,d3d12core,dxgi=b"
export WINEDLLOVERRIDES
export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-warn}"
export WINETRICKS_LATEST_VERSION_CHECK=disabled
# winepulse con PipeWire: un colchón de 60 ms evita el audio entrecortado en muchos juegos
[ "${INK_PULSE_LATENCY:-60}" = 0 ] || export PULSE_LATENCY_MSEC="${PULSE_LATENCY_MSEC:-${INK_PULSE_LATENCY:-60}}"

prefix_ok() { [ -f "$WINEPREFIX/system.reg" ] || { echo "No hay prefijo en $WINEPREFIX: ejecuta ./6-wine.sh" >&2; exit 1; }; }

case "${1:-}" in
  cfg)    prefix_ok; exec winecfg ;;
  kill)   exec wineserver -k ;;
  builtin)
    prefix_ok
    for d in d3d8 d3d9 d3d10core d3d11 d3d12 d3d12core dxgi; do
      wine reg delete 'HKCU\Software\Wine\DllOverrides' /v "$d" /f >/dev/null 2>&1
    done
    wineserver -w
    echo "Overrides de Direct3D quitados de $WINEPREFIX: vuelve a usar el Direct3D de Wine."
    exit 0 ;;
  tricks) shift; prefix_ok; exec winetricks "$@" ;;
  info)
    echo "Wine:       $(wine --version)"
    echo "winetricks: $(winetricks --version 2>/dev/null | head -n1)"
    echo "Prefijo:    $WINEPREFIX $([ -f "$WINEPREFIX/system.reg" ] && echo "($(sed -n 's/^#arch=//p' "$WINEPREFIX/system.reg" | head -n1))" || echo "(no existe)")"
    [ -e /dev/ntsync ] && echo "ntsync:     activo" || echo "ntsync:     no disponible (usa esync/fsync)"
    if ls /usr/share/vulkan/icd.d/*.json >/dev/null 2>&1; then echo "Vulkan:     $(ls /usr/share/vulkan/icd.d/ | sed 's/_icd.*//;s/\.json//' | tr '\n' ' ')"; else echo "Vulkan:     sin ICD (DXVK no funcionará)"; fi
    if [ -f "$WINEPREFIX/user.reg" ]; then
        ov=$(sed -n '/^\[Software\\\\Wine\\\\DllOverrides\]/,/^$/p' "$WINEPREFIX/user.reg" | grep -E '"(d3d|dxgi)' | sed 's/^"\([^"]*\)"="\([^"]*\)".*/\1=\2/' | tr '\n' ' ')
        echo "Overrides D3D: ${ov:-ninguno (Direct3D de Wine)}"
    fi
    [ -f "$WINEPREFIX/system.reg" ] && { echo "Verbos:     $(winetricks list-installed 2>/dev/null | grep -E '^[a-z0-9_=]+$' | tr '\n' ' ')"; }
    exit 0 ;;
esac

prefix_ok
f=$1; shift
[ -e "$f" ] || { echo "No existe: $f" >&2; exit 1; }
f=$(readlink -f -- "$f")
cd "$(dirname "$f")" || exit 1   # muchos juegos buscan sus datos en la carpeta de trabajo
run=(); [ "${INK_GAMEMODE:-0}" = 1 ] && command -v gamemoderun >/dev/null 2>&1 && run=(gamemoderun)
case "${f,,}" in
  *.msi)          exec "${run[@]}" wine msiexec /i "$f" "$@" ;;
  *.bat|*.cmd)    exec "${run[@]}" wine cmd /c "$f" "$@" ;;
  *.lnk)          exec "${run[@]}" wine start /unix "$f" "$@" ;;
  *)              exec "${run[@]}" wine "$f" "$@" ;;
esac
