#!/bin/sh
# keys — chuleta de atajos en fuzzel (solo lectura; Enter o Esc la cierran; escribe para filtrar).
# Se ajusta sola a la pantalla (ink-fuzzel): en un portátil pequeño muestra las filas que caben y el resto se
# desplaza. Mantén las descripciones cortas: el ancho se calcula con la línea más larga.
pkill -x fuzzel && exit 0
txt=$(cat <<'TXT'
󰀻  Super+D          buscar apps
󰆍  Super+Enter      terminal
󰖟  Super+B          navegador (Shift: incógnito)
󰉋  Super+E          archivos (yazi)
󰅌  Super+V          historial del portapapeles
󰒓  Super+Espacio    centro de control
󰌌  Super+F1         esta chuleta
󰸉  Super+W          fondo (Shift: azar · Alt: siguiente)
󰏘  Super+C          acento (Shift: el del fondo)
󰖔  Super+Z          luz nocturna (Shift: nivel)
󰓃  Super+A          salida de audio (Shift: entrada)
󰖩  Super+Y          redes Wi-Fi
󰄀  Print            captura (Shift: área · Ctrl: copiar)
󰏫  Super+Print      captura y anotar
󰑋  Super+Shift+P    grabar pantalla (Super+Ctrl+P: un área)
󰚰  Super+U          actualizar (repos + AUR)
󰋽  Super+F2         estado y seguridad del sistema
󰍹  Super+F3         pantallas (modo, escala, giro)
󰂚  Super+Ctrl+N     historial de notificaciones
󰂛  Super+N          no molestar (Shift: descartar)
󰌾  Super+Shift+L    bloquear
󰐥  Super+Esc        menú de sesión
󰖲  Super+Q          cerrar ventana
󰖲  Super+Shift+Q    cerrar aplicación sin respuesta
󰇄  Super+Tab        cambiar de ventana (o Alt+Tab)
󰇄  Super+Shift+Tab  ventana anterior (o Alt+Shift+Tab)
󰊓  Super+F          maximizar (Shift: pantalla completa)
󰘕  Super+M          minimizar
󰍽  Super+H/J/K/L    ventana a media pantalla: ←↓↑→
󰁜  Super+T          ventana siempre encima
󰇄  Super+Shift+D    mostrar / ocultar ventanas
󰊓  Super+Shift+M    ventana en todos los escritorios
󰍹  Super+Shift+←/→  ventana a otra pantalla
󰇄  Super+1..4       escritorio (Shift: llevar ventana)
󰁔  Super+Ctrl+←/→   otro escritorio (Shift: llevar ventana)
󰄪  Ctrl+Shift+Esc   monitor del sistema (btop)
󰓃  Teclas multimedia  volumen, brillo y reproducción (incluso bloqueado)
󰑓  Super+Shift+R    recargar labwc
TXT
)
w=$(printf '%s\n' "$txt" | awk '{ if (length($0) > m) m = length($0) } END { print m + 4 }')
n=$(printf '%s\n' "$txt" | wc -l)   # pedir solo las filas que hay: así no quedan huecos al añadir atajos
printf '%s\n' "$txt" | ink-fuzzel --dmenu --lines "$n" --width "$w" --prompt "󰌌  " --placeholder "Atajos… (escribe para filtrar)" >/dev/null
